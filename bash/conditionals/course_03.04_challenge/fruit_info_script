#!/bin/bash

# Description: Tell the color of a fruit

name="Description: Tell the color of a fruit"
echo "$name"

fruit="$1"
echo "Script name: $0"
echo "Argument count: $#"
echo "You chose: $fruit"

if [[ $# -ne 1 ]]; then
	echo "Usage: $0 <fruit>" >&2
	exit 1
fi


fruit="$1"

case "$fruit" in
	apple)
		echo "Red or greed"
		;;
	banana)
		echo "Yellow"
		;;
	orange)
		echo "Orange"
		;;
	grape)
		echo "Purple or green"
		;;
	*)
		echo "Unknown fruit: $fruit" >&2
		exit 1
		;;
esac
